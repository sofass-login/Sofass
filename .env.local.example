# Copia este archivo a .env.local y rellena con los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY
# Solo para el servidor (invitar usuarios). NUNCA lo pongas en NEXT_PUBLIC_ ni lo subas a un repo público.
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY
